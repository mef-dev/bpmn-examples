    <task id="Inline_Action" name="getConfig">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"{\r\n    var json = new JSON(Input);\r\n\r\n    // ------- safe helpers -------\r\n    object GetRaw(string path)\r\n    {\r\n        try\r\n        {\r\n            var node = json.JsonPath(path);      // node може бути null\r\n            return node != null ? node.Value : null;\r\n        }\r\n        catch { return null; }\r\n    }\r\n\r\n    string GetStr(string path, string fallback)\r\n    {\r\n        var v = GetRaw(path);\r\n        var s = v != null ? v.ToString() : null;\r\n        return string.IsNullOrWhiteSpace(s) ? fallback : s;\r\n    }\r\n\r\n    int GetInt(string path, int fallback)\r\n    {\r\n        var v = GetRaw(path);\r\n        if (v != null &amp;&amp; int.TryParse(v.ToString(), out var n) &amp;&amp; n &gt; 0) return n;\r\n        return fallback;\r\n    }\r\n\r\n    bool GetBool(string path, bool fallback)\r\n    {\r\n        var v = GetRaw(path);\r\n        if (v != null &amp;&amp; bool.TryParse(v.ToString(), out var b)) return b;\r\n        return fallback;\r\n    }\r\n    // ----------------------------\r\n\r\n    // базові поля\r\n    string brokers = GetStr(\"$.brokers\", \"localhost:9092\");\r\n    string groupId = GetStr(\"$.groupId\", \"demo\");\r\n    string topic   = GetStr(\"$.topic\",   \"demo\");\r\n    int    max     = GetInt(\"$.max\",      10);\r\n    int    timeout = GetInt(\"$.timeout\", 1000);\r\n\r\n    // безпека (може бути відсутня у вхідному JSON)\r\n    bool   useSsl  = GetBool(\"$.security.ssl\", false);\r\n    string mech    = GetStr(\"$.security.mechanism\", \"\");\r\n    string user    = GetStr(\"$.security.username\",  \"\");\r\n    string pass    = GetStr(\"$.security.password\",  \"\");\r\n\r\n    var parts = new List&lt;string&gt;\r\n    {\r\n        $\"bootstrap.servers={brokers}\",\r\n        $\"group.id={groupId}\",\r\n        \"auto.offset.reset=earliest\"\r\n    };\r\n\r\n    // якщо передали security — додамо параметри\r\n    if (useSsl &amp;&amp; (!string.IsNullOrEmpty(user) || !string.IsNullOrEmpty(mech)))\r\n        parts.Add(\"security.protocol=SASL_SSL\");\r\n    else if (useSsl)\r\n        parts.Add(\"security.protocol=SSL\");\r\n\r\n    if (!string.IsNullOrEmpty(mech)) parts.Add($\"sasl.mechanism={mech}\");\r\n    if (!string.IsNullOrEmpty(user)) parts.Add($\"sasl.username={user}\");\r\n    if (!string.IsNullOrEmpty(pass)) parts.Add($\"sasl.password={pass}\");\r\n\r\n    var cfg = new ServiceConfig\r\n    {\r\n        ConnectionString = string.Join(\";\", parts),\r\n        Topic            = topic,\r\n        MaxMessages      = max,\r\n        TimeoutMs        = timeout\r\n    };\r\n    // Logger.LogInformation\r\n    Logger.LogInformation($\"Kafka cfg built: {cfg.ConnectionString}; topic={cfg.Topic}; max={cfg.MaxMessages}; timeout={cfg.TimeoutMs};\");\r\n    return cfg;\r\n}\r\n","actionParam":null,"libName":"","libEntity":"","libMethod":""}</ep:elementParameter>
      </extensionElements>
      <incoming>Flow_0xuw6mo</incoming>
      <outgoing>Flow_0dc2tim</outgoing>
    </task>
    <sequenceFlow id="Flow_0dc2tim" sourceRef="Inline_Action" targetRef="Event_0sav6wr" />
  </process>
