    <gp:globalParameter name="Parameters">[{"name":"sseMsg","type":"SseMessage","initialValue":""},{"name":"httpConfig","type":"HttpConfig","initialValue":"{\r\n   \"host\":\"https://10.29.101.122\",\r\n   \"port\":\"6992\",\r\n   \"login\":\"api_user\",\r\n   \"password\":\"Widecoup1\",\r\n   \"encoding\":\"utf-8\",\r\n   \"headers\":{\r\n      \"Content-Type\":\"application/vnd.api+json\",\r\n      \"Accept\":\"application/vnd.api+json\"\r\n   }\r\n}\r\n"},{"name":"oracleConfig","type":"OracleConfig","initialValue":"{\r\n   \"userId\":\"wcb2fcs\",\r\n   \"password\":\"natec2fcs_2019\",\r\n   \"dataSource\":\"10.49.1.198:1521/bisdb_prm.kyivstar.ua\"\r\n}\r\n"}]</gp:globalParameter>
