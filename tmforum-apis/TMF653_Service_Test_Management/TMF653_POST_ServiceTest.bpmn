     return prefix;        \n}",    "initParameters": [      {        "name": "Result",        "type": "string",        "required": false,        "defaultValue": null      }    ]  },  {    "name": "HandleException",    "initCode": "Error HandleException (\n\t\tPassingResult prevData\n\t)                  \n    {\n                try\n        {\n            //investigate the Exception \n            Logger.LogInformation($\"Exception name : {prevData.Exception?.GetType()?.Name}\");\n\n            Error result = new Error(){ status = \"500\"};\n            if (prevData.Exception != null)\n            {\n                result = prevData.Exception.GetError(\"500\");\n            }\n            \n            int statusCode = 500;\n            int.TryParse(result?.status, out statusCode);\n            \n                WorkflowEnvironment.Variables[\"StatusCode\"] = 500;            \n                if (WorkflowEnvironment.Variables.TryGetValue    (\"HttpResponse\", out object httpResponseObj))\n                {\n                    Microsoft.AspNetCore.Http.HttpResponse response =     httpResponseObj as Microsoft.AspNetCore.Http.HttpResponse;\n                    response.StatusCode = statusCode;\n                }         \n            return result;\n        }\n        catch (Exception e) \n        {\n            Logger.LogError($\"HandleException:: error {e}\");\n                if (WorkflowEnvironment.Variables.TryGetValue    (\"HttpResponse\", out object httpResponseObj))\n                {\n                    Microsoft.AspNetCore.Http.HttpResponse response =     httpResponseObj as Microsoft.AspNetCore.Http.HttpResponse;\n                    //Parameters.x_ms_client_request_id\n                    response.StatusCode = 500;\n                }            \n            return new Error() \n            { \n                status = \"500\",\n                message = $\"Error while handle error ! {e.Message}\"\n            };\n        }\n    }",    "initParameters": [      {        "name": "Result",        "type": "Error",        "required": false,        "defaultValue": null      },      {        "name": "prevData",        "type": "PassingResult",        "required": true,        "defaultValue": null      }    ]  },  {    "name": "proceedSessionParameters",    "initCode": "Json proceedSessionParameters (\n\t)\n{\n            string v_author = null;\n            string v_hostname = null;\n            //Note[] notes = null;\n            string idStr = Input?.relatedService?.id;\n            if(!string.IsNullOrEmpty(idStr))\n            {\n                var match = Regex.Match(idStr, @\"^\\d{1,2}-(?&lt;sec_num&gt;\\d{1,10})$\");\n                if (match.Success)\n                {\n                    if (int.TryParse(match.Groups[\"sec_num\"].Value, out int sec_num))\n                    {\n                        Parameters.idIsCorrect = true;\n                    }\n                }                \n            }\n            if(WorkflowEnvironment.RuntimeName == \"Plugin\")\n            {\n                if (WorkflowEnvironment.Variables.TryGetValue(\"ApiContext\", out object apiContextObj))\n                {\n                    IApiContext apiContext = apiContextObj as IApiContext;\n                    v_author = apiContext.DataBag.UserName;\n                    v_hostname = apiContext.DataBag.From;\n                }\n\n                if (WorkflowEnvironment.Variables.TryGetValue(\"HttpRequest\", out object httpRequestObj))\n                {\n                    Microsoft.AspNetCore.Http.HttpRequest req = httpRequestObj as Microsoft.AspNetCore.Http.HttpRequest;\n                    if (req.Headers.TryGetValue(\"x_ms_client_request_id\",     out var reqIdValues))\n                    {\n                        Parameters.x_ms_client_request_id = reqIdValues.FirstOrDefault();\n                    }\n                }\n                /*\n\t\t\t\tvar note = Input.note?.Select(n =&gt; new Note()\n\t\t\t\t{\n\t\t\t\t\tauthor = n.author,\n\t\t\t\t\thostname = n.hostname,\n\t\t\t\t\ttext = n.text\n\t\t\t\t})?.FirstOrDefault() ?? new Note();\n\t\t\t\t\n\t\t\t\tnote.author = v_author;\n\t\t\t\tnote.hostname = v_hostname;\n\t\t\t\t\n                notes = new Note[1]{note};\n                */\n            }\n            else\n            {\n                //Parameters.x_ms_client_request_id = Input.x_ms_client_request_id;\n                //notes = Input.note;                \n            }\n            \n            if (this.WorkflowEnvironment.Variables.TryGetValue(\"ConfigString\", out object configStr))\n            {\n                var configJson = new JSON(configStr).Cast&lt;ServiceConfig&gt;();\n                if(!string.IsNullOrEmpty(configJson?.ConnectionString))\n                {\n                    Parameters.sqlConnectionString = configJson.ConnectionString;\n                }\n            };\n            //return new JSON(notes);       \n            return null;\n    }",    "initParameters": [      {        "name": "Result",        "type": "Json"      }    ]  },  {    "name": "setResponseStatus",    "initCode": "void setResponseStatus (\n\t\tint statusCode\n\t)  \n    {\n        // TODO Insert your code here\n        WorkflowEnvironment.Variables[\"StatusCode\"] = statusCode;\n        if (WorkflowEnvironment.Variables.TryGetValue(\"HttpResponse\", out object httpResponseObj))\n        {\n            Microsoft.AspNetCore.Http.HttpResponse response = httpResponseObj as Microsoft.AspNetCore.Http.HttpResponse;\n            response.StatusCode = statusCode;\n        }        \n    }",    "initParameters": [      {        "name": "Result",        "type": null,        "required": false,        "defaultValue": null      },      {        "name": "statusCode",        "type": "int",        "required": false,        "defaultValue": null      }    ]  },  {    "name": "p_ucp_get_ServiceTest",    "initCode": "ServiceTest_Response_GET_OUTPUT[] p_ucp_get_ServiceTest(string Lang, string ErrFormat, string relatedService, string x_ms_client_request_id, string mode, string testSpecification)\n{\r\n var p = new DynamicParameters();\r\np.Add(\"Lang\", value: Lang, dbType: DbType.String, direction:ParameterDirection.InputOutput, size:3);\r\np.Add(\"ErrFormat\", value: ErrFormat, dbType: DbType.String, direction:ParameterDirection.Input, size:25);\r\np.Add(\"relatedService\", value: relatedService, dbType: DbType.String, direction:ParameterDirection.Input, size:-1);\r\np.Add(\"x_ms_client_request_id\", value: x_ms_client_request_id, dbType: DbType.String, direction:ParameterDirection.InputOutput, size:32);\r\np.Add(\"mode\", value: mode, dbType: DbType.String, direction:ParameterDirection.Input, size:50);\r\np.Add(\"testSpecification\", value: testSpecification, dbType: DbType.String, direction:ParameterDirection.Input, size:-1);\r\n\r\nstring sqlConnectionString = Parameters.sqlConnectionString;\r\nif (this.WorkflowEnvironment.Variables.TryGetValue(\"ConfigString\", out object configStr))\r\n{\r\n     var configJson = new JSON(configStr).Cast&lt;ServiceConfig&gt;();\r\n     if(!string.IsNullOrEmpty(configJson?.ConnectionString))\r\n     {\r\n        sqlConnectionString = configJson.ConnectionString;\r\n     }\r\n};\r\n\r\nvar procedure = \"[dbo].[p_ucp_get_ServiceTest]\";\r\nList&lt;ServiceTest_Response_GET_OUTPUT&gt; resultDataSet = null;\r\nint? xTotalCount = 0;\r\n\r\nusing (var connection = new SqlConnection(sqlConnectionString))\r\n{\r\n     var queryResult = connection.QueryMultiple(procedure, p, commandType: CommandType.StoredProcedure, commandTimeout:0);\r\n     resultDataSet = queryResult.Read()\r\n          .Select((d) =&gt; {\r\n            xTotalCount = d.Total;\r\n            var rowResult = new ServiceTest_Response_GET_OUTPUT()\r\n             {\r\n                   validFor = new JSON(d.validFor).Cast&lt;TimePeriod&gt;(),\r\n                   relatedParty = new JSON(d.relatedParty).Cast&lt;RelatedParty[]&gt;(),\r\n                   relatedService = new JSON(d.RelatedService).Cast&lt;RelatedService&gt;(),\r\n                   testSpecification = new JSON(d.testSpecification).Cast&lt;TestSpecification&gt;(),\r\n                   //@type = &lt;mapping is no found&gt;\r\n                   mode = d.mode,\r\n                   startDateTime = d.startDateTime,\r\n                   state = d.state,\r\n                   characteristic = new JSON(d.characteristic).Cast&lt;Characteristic[]&gt;()\r\n                   //characteristic = new JSON(d.characteristic).Cast&lt;dynamic&gt;(),\r\n             };\r\n            return rowResult;\r\n            })\r\n     .ToList();\r\n}\r\n\r\n// fill output params\r\nServiceTest_Response_GET result = new ServiceTest_Response_GET();\r\nresult.Accept_Language = p.Get&lt;System.String&gt;(\"Lang\");\r\nresult.x_ms_client_request_id = p.Get&lt;System.String&gt;(\"x_ms_client_request_id\");\r\n/*\r\n     var range = new RangeParameters(result.offset.GetValueOrDefault(),\r\n         result.limit.GetValueOrDefault(),\r\n         xTotalCount);\r\n         */\r\n     var res = new ProcedureWebOutput();\r\n     res.Result = result;\r\n     res.DataSet = resultDataSet;\r\n     //res.Range = range;\r\n     res.Headers = new Dictionary&lt;string, string&gt;();\r\n         res.Headers[\"Accept-Language\"] = result.Accept_Language;\r\n         result.Accept_Language = null;\r\n         res.Headers[\"x-ms-client-request-id\"] = result.x_ms_client_request_id;\r\n         result.x_ms_client_request_id = null;\r\n/*         \r\n     res.Headers[\"Content-Range\"] = range.Content_Range;\r\n     res.Headers[\"X-Total-Count\"] = range.X_Total_Count.ToString();\r\n     if ((range.X_Total_Count &gt; 0) &amp;&amp; (range.Limit &gt; 0))\r\n         res.Headers[\"X-Page-Count\"] = range.X_Page_Count.ToString();\r\n     else\r\n         res.Headers[\"X-Page-Count\"] = \"0\";\r\n     Parameters.x_page_count = range.X_Page_Count;\r\n*/\r\nreturn res.DataSet;\r\n}",    "initParameters": [      {        "type": "string",        "name": "Lang",        "defaultValue": ""      },      {        "type": "string",        "name": "ErrFormat",        "defaultValue": ""      },      {        "type": "string",        "name": "relatedService",        "defaultValue": ""      },      {        "type": "string",        "name": "x_ms_client_request_id",        "defaultValue": ""      },      {        "type": "string",        "name": "mode",        "defaultValue": ""      },      {        "type": "string",        "name": "testSpecification",        "defaultValue": ""      },      {        "name": "Result",        "type": "ServiceTest_Response_GET_OUTPUT[]"      }    ]  }]</gp:globalParameter>
