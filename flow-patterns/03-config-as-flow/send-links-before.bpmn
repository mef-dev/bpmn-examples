    <sequenceFlow id="Flow_1m73j3r" sourceRef="Activity_00ussmu" targetRef="Activity_04gn2d0" />
    <sequenceFlow id="Flow_0y201wn" sourceRef="Activity_04gn2d0" targetRef="Gateway_16gjvgb" />
    <task id="Activity_0kruhwu" name="формуємо список урлів">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"var linksList = #Previous;\r\nvar sb = new StringBuilder();\r\n\r\nsb.AppendLine(\r\n    \"&lt;p style='font-family:Arial,sans-serif;font-size:14px;line-height:1.5;'&gt;\" +\r\n    \"Це автоматичне повідомлення. Нижче наведено перелік білінгових рахунків на оплату \" +\r\n    \"із зазначенням ідентифікатора &lt;strong&gt;Service Line&lt;/strong&gt;, які були згенеровані \" +\r\n    \"системою WideCoup BSS для послуги доступу до двостороннього супутникового \" +\r\n    \"Інтернету Starlink.\" +\r\n    \"&lt;/p&gt;\"\r\n);\r\n\r\nsb.AppendLine(\r\n    \"&lt;table style='border-collapse:collapse;width:100%;font-family:Arial,sans-serif;font-size:14px;'&gt;\"\r\n);\r\n\r\nsb.AppendLine(\r\n    \"&lt;thead&gt;\" +\r\n        \"&lt;tr&gt;\" +\r\n            \"&lt;th style='border:1px solid #d9d9d9;padding:10px;text-align:left;background-color:#f2f2f2;'&gt;\" +\r\n                \"Service Line\" +\r\n            \"&lt;/th&gt;\" +\r\n        \"&lt;/tr&gt;\" +\r\n    \"&lt;/thead&gt;\"\r\n);\r\n\r\nsb.AppendLine(\"&lt;tbody&gt;\");\r\n\r\nforeach (var links in linksList)\r\n{\r\n    foreach (var lnk in links)\r\n    {\r\n        sb.AppendLine(\r\n            \"&lt;tr&gt;\" +\r\n                \"&lt;td style='border:1px solid #d9d9d9;padding:10px;'&gt;\" +\r\n                    $\"&lt;a href='{lnk.Url}' target='_blank'&gt;{lnk.FileName}&lt;/a&gt;\" +\r\n                \"&lt;/td&gt;\" +\r\n            \"&lt;/tr&gt;\"\r\n        );\r\n    }\r\n}\r\n\r\nsb.AppendLine(\"&lt;/tbody&gt;\");\r\nsb.AppendLine(\"&lt;/table&gt;\");\r\n\r\nsb.AppendLine(\r\n    \"&lt;p style='font-family:Arial,sans-serif;font-size:12px;color:#777777;margin-top:16px;'&gt;\" +\r\n    \"Повідомлення сформовано автоматично. Будь ласка, не відповідайте на нього.\" +\r\n    \"&lt;/p&gt;\"\r\n);\r\n\r\nreturn sb.ToString();"}</ep:elementParameter>
      </extensionElements>
      <incoming>Flow_1tu67dt</incoming>
      <outgoing>Flow_083g3kv</outgoing>
    </task>
