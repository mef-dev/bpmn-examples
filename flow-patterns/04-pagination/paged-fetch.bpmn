<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gp="http://some-company/schema/bpmn/qa" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ep="http://some-company/schema/bpmn/ep" targetNamespace="" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <extensionElements>
    <gp:globalParameter name="InnerTypes">[{"name": "PageInfo", "isNativeDefinition": true, "definition": "public class PageInfo\n{\n    public int number { get; set; }\n    public int startIndex { get; set; }\n    public int size { get; set; }\n}", "dataObjectRefName": "PageInfo"}, {"name": "PageRequest", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/PageRequest\", \"definitions\": {\"PageRequest\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"total\": {\"type\": \"integer\"}}, \"title\": \"PageRequest\"}}}", "isNativeDefinition": false}, {"name": "ErrorResponse", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/ErrorResponse\", \"definitions\": {\"ErrorResponse\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"LevelMessage\": {\"type\": \"string\"}, \"statusCode\": {\"type\": \"integer\"}, \"Message\": {\"type\": \"string\"}, \"State\": {\"type\": \"string\"}}, \"title\": \"ErrorResponse\"}}}", "isNativeDefinition": false}]</gp:globalParameter>
    <gp:globalParameter name="ExternalTypes">[{"name": "ExternalConfig", "definition": "types://external/ConfigActivity/Config"}]</gp:globalParameter>
    <gp:globalParameter name="CodeActions">[{"name": "HandleException", "initCode": "ErrorResponse HandleException(PassingResult prevData)\n{\n    Logger.LogError($\"flow failed: {prevData.Exception?.Message}\");\n    WorkflowEnvironment.Variables[\"StatusCode\"] = 500;\n    if (WorkflowEnvironment.Variables.TryGetValue(\"HttpResponse\", out object rawResponse)\n        &amp;&amp; rawResponse is Microsoft.AspNetCore.Http.HttpResponse httpResponse)\n        httpResponse.StatusCode = 500;\n    return new ErrorResponse()\n    {\n        Message = prevData.Exception?.Message,\n        LevelMessage = \"11\",\n        statusCode = 500,\n        State = \"1\"\n    };\n}", "initParameters": [{"name": "Result", "type": "ErrorResponse"}, {"name": "prevData", "type": "PassingResult", "required": true}]}]</gp:globalParameter>
    <gp:globalParameter name="Functions">[]</gp:globalParameter>
    <gp:globalParameter name="UsedLibs">[{"name": "ConfigActivity", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}]</gp:globalParameter>
    <gp:globalParameter name="Parameters">[{"name": "config", "type": "ExternalConfig", "initialValue": ""}]</gp:globalParameter>
  </extensionElements>
  <process id="Process_paged_fetch" name="paged-fetch">
      <documentation>Plans the pages first, then walks them with Multi Instance.
Source: https://github.com/mef-dev/bpmn-examples/tree/master/flow-patterns/04-pagination</documentation>
    <dataObjectReference id="DO_Input" name="PageRequest" dataObjectRef="Do_Input" />
    <dataObject id="Do_Input" />
    <dataObjectReference id="DO_Output" name="PageInfo[]" dataObjectRef="Do_Output" />
    <dataObjectReference id="DO_Output_1" name="ErrorResponse" dataObjectRef="Do_Output_1" />
    <dataObject id="Do_Output_1" />
    <dataObject id="Do_Output" isCollection="true" />
    <dataObjectReference id="DO_Pages" name="PageInfo[]" dataObjectRef="Do_Pages" />
    <dataObject id="Do_Pages" isCollection="true" />
    <startEvent id="Ev_Start" name="paged-fetch">
      <documentation>Starts paged-fetch. Request: PageRequest (total: integer).</documentation>
      <extensionElements>
        <ep:elementParameter name="StartSignalRoute">{"status": "HttpRequestAttributes", "examples": {"PAGES": {"summary": "the example input", "description": "", "value": "{\n  \"total\": 25\n}"}}}</ep:elementParameter>
      </extensionElements>
      <outgoing>Fl_001</outgoing>
      <dataOutputAssociation id="Doa_Input">
        <targetRef>DO_Input</targetRef>
      </dataOutputAssociation>
    </startEvent>
    <callActivity id="CA_Config" name="Get Config">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "bpmn-examples-config", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_001</incoming>
      <outgoing>Fl_002</outgoing>
    </callActivity>
    <task id="T_ParseConfig" name="Parse Config">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// A Call Activity result is converted through JSON: new JSON(...)\n// takes the called Flow's object and JSON alike.\nExternalConfig cfg = new JSON(#Previous).Cast&lt;ExternalConfig&gt;()\n    ?? throw new Exception(\"bpmn-examples-config returned no settings\");\nParameters.config = cfg;\nLogger.LogInformation($\"config loaded from bpmn-examples-config\");\nreturn cfg;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_002</incoming>
      <outgoing>Fl_003</outgoing>
    </task>
    <task id="T_Plan" name="plan the pages">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// The page size is a setting, not a constant: it belongs in the\n// configuration Flow so every consumer agrees on it.\nvar size = Parameters.config.pageSize;\n\n// This step only plans. Building the list first, and walking it\n// second, is what lets the Sub Process run the pages in parallel.\nvar pages = new List&lt;PageInfo&gt;();\nfor (int start = 0; start &lt; Input.total; start += size)\n    pages.Add(new PageInfo() { number = pages.Count + 1, startIndex = start, size = size });\n\nLogger.LogInformation($\"{Input.total} rows split into {pages.Count} pages of {size}\");\nreturn pages;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_003</incoming>
      <outgoing>Fl_004</outgoing>
      <dataOutputAssociation id="Doa_T_Plan">
        <targetRef>DO_Pages</targetRef>
      </dataOutputAssociation>
    </task>
    <subProcess id="SP_Page" name="handle one page">
      <extensionElements>
        <ep:elementParameter name="PackSize">2</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_004</incoming>
      <outgoing>Fl_005</outgoing>
      <property id="Prop_SP_Page" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_SP_Page">
        <sourceRef>DO_Pages</sourceRef>
        <targetRef>Prop_SP_Page</targetRef>
      </dataInputAssociation>
      <multiInstanceLoopCharacteristics />
      <dataObjectReference id="SP_Page_DO_In" name="PageInfo" dataObjectRef="SP_Page_Do_In" />
      <dataObject id="SP_Page_Do_In" />
      <dataObjectReference id="SP_Page_DO_Out" name="PageInfo" dataObjectRef="SP_Page_Do_Out" />
      <dataObject id="SP_Page_Do_Out" />
      <startEvent id="Ev_SP_Page_Start" name="">
        <outgoing>Fl_SP_Page_01</outgoing>
        <dataOutputAssociation id="Doa_Ev_SP_Page_Start">
          <targetRef>SP_Page_DO_In</targetRef>
        </dataOutputAssociation>
      </startEvent>
      <task id="T_Page" name="read one page">
        <extensionElements>
          <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// Inside the loop Input is ONE element of the list, not the list.\nvar page = (PageInfo)Input;\n\n// Parameters here belong to the Sub Process; the outer scope is Root.\nvar url = $\"{Root.Parameters.config.listUrl}?_start={page.startIndex}&amp;_limit={page.size}\";\nLogger.LogInformation($\"page {page.number} would read {url}, pass {Transition.Counter}\");\nreturn page;"}</ep:elementParameter>
        </extensionElements>
        <incoming>Fl_SP_Page_01</incoming>
        <outgoing>Fl_SP_Page_02</outgoing>
      </task>
      <endEvent id="Ev_SP_Page_End" name="">
        <incoming>Fl_SP_Page_02</incoming>
        <property id="Prop_Ev_SP_Page_End" name="__targetRef_placeholder" />
        <dataInputAssociation id="Dia_Ev_SP_Page_End">
          <sourceRef>SP_Page_DO_Out</sourceRef>
          <targetRef>Prop_Ev_SP_Page_End</targetRef>
        </dataInputAssociation>
      </endEvent>
      <sequenceFlow id="Fl_SP_Page_01" sourceRef="Ev_SP_Page_Start" targetRef="T_Page" />
      <sequenceFlow id="Fl_SP_Page_02" sourceRef="T_Page" targetRef="Ev_SP_Page_End" />
    </subProcess>
    <endEvent id="Ev_End" name="paged-fetch">
      <documentation>Success, HTTP 200, PAGES: returns PageInfo[].</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "200", "exampelsVariants": [{"title": "PAGES", "value": "[\n  {\n    \"number\": 1,\n    \"startIndex\": 0,\n    \"size\": 10\n  },\n  {\n    \"number\": 2,\n    \"startIndex\": 10,\n    \"size\": 10\n  },\n  {\n    \"number\": 3,\n    \"startIndex\": 20,\n    \"size\": 10\n  }\n]"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_005</incoming>
      <property id="Prop_Ev_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_End">
        <sourceRef>DO_Output</sourceRef>
        <targetRef>Prop_Ev_End</targetRef>
      </dataInputAssociation>
    </endEvent>
    <task id="T_HandleException" name="handle Exception">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Action", "action": "HandleException", "actionParam": {"prevData": "#PreviousData"}}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_006</incoming>
      <incoming>Fl_007</incoming>
      <outgoing>Fl_008</outgoing>
    </task>
    <endEvent id="Ev_Failed" name="paged-fetch">
      <documentation>Failure, HTTP 500, PAGING_FAILED: returns ErrorResponse built by the error branch from the exception of the step that failed.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "500", "exampelsVariants": [{"title": "PAGING_FAILED", "value": "{\n  \"levelMessage\": \"11\",\n  \"statusCode\": 500,\n  \"message\": \"the page plan could not be built\",\n  \"state\": \"1\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_008</incoming>
      <property id="Prop_Ev_Failed" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_Failed">
        <sourceRef>DO_Output_1</sourceRef>
        <targetRef>Prop_Ev_Failed</targetRef>
      </dataInputAssociation>
    </endEvent>
    <boundaryEvent id="Ev_Err_CA_Config" name="" attachedToRef="CA_Config">
      <outgoing>Fl_006</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_CA_Config" />
    </boundaryEvent>
    <boundaryEvent id="Ev_Err_T_ParseConfig" name="" attachedToRef="T_ParseConfig">
      <outgoing>Fl_007</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_ParseConfig" />
    </boundaryEvent>
    <sequenceFlow id="Fl_001" sourceRef="Ev_Start" targetRef="CA_Config" />
    <sequenceFlow id="Fl_002" sourceRef="CA_Config" targetRef="T_ParseConfig" />
    <sequenceFlow id="Fl_003" sourceRef="T_ParseConfig" targetRef="T_Plan" />
    <sequenceFlow id="Fl_004" sourceRef="T_Plan" targetRef="SP_Page" />
    <sequenceFlow id="Fl_005" sourceRef="SP_Page" targetRef="Ev_End" />
    <sequenceFlow id="Fl_006" sourceRef="Ev_Err_CA_Config" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_007" sourceRef="Ev_Err_T_ParseConfig" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_008" sourceRef="T_HandleException" targetRef="Ev_Failed" />
    <textAnnotation id="An_Input">
      <text>Example input:
{
  "total": 25
}</text>
    </textAnnotation>
    <association id="As_An_Input" sourceRef="An_Input" targetRef="Ev_Start" />
    <textAnnotation id="An_T_Plan">
      <text>The page size is a setting, not a constant, so it lives in
the configuration Flow. Planning first and walking the
list second is what lets the pages run in parallel.</text>
    </textAnnotation>
    <association id="As_An_T_Plan" sourceRef="An_T_Plan" targetRef="T_Plan" />
    <textAnnotation id="An_SP_Page">
      <text>Multi Instance runs this Sub Process once per element of
the list it receives; PackSize caps how many run together.
Inside, Input is one page, not the list, and the outer
Parameters are reached through Root.</text>
    </textAnnotation>
    <association id="As_An_SP_Page" sourceRef="An_SP_Page" targetRef="SP_Page" />

  </process>
  <bpmndi:BPMNDiagram id="Di_Process_paged_fetch">
    <bpmndi:BPMNPlane id="Dp_Process_paged_fetch" bpmnElement="Process_paged_fetch">
      <bpmndi:BPMNShape id="Sh_DO_Input" bpmnElement="DO_Input">
