    </task>
    <sequenceFlow id="Flow_0isdzfm" sourceRef="Gateway_13awzup" targetRef="Activity_Read_Response" />
    <sequenceFlow id="Flow_1k2gom5" sourceRef="Gateway_13awzup" targetRef="Inline_Action_ReadSend_Lines" />
