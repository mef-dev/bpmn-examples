        <di:waypoint x="128" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Dia_Ev_End" bpmnElement="Dia_Ev_End">
        <di:waypoint x="128" y="215" />
        <di:waypoint x="300" y="215" />
        <di:waypoint x="300" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Dia_Ev_Failed" bpmnElement="Dia_Ev_Failed">
        <di:waypoint x="448" y="277" />
        <di:waypoint x="638" y="277" />
        <di:waypoint x="638" y="680" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
