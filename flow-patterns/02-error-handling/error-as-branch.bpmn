<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gp="http://some-company/schema/bpmn/qa" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ep="http://some-company/schema/bpmn/ep" targetNamespace="" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <extensionElements>
    <gp:globalParameter name="InnerTypes">[{"name": "OrderRequest", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/OrderRequest\", \"definitions\": {\"OrderRequest\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"orderId\": {\"type\": \"string\"}}, \"title\": \"OrderRequest\"}}}", "isNativeDefinition": false}, {"name": "ErrorResponse", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/ErrorResponse\", \"definitions\": {\"ErrorResponse\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"LevelMessage\": {\"type\": \"string\"}, \"statusCode\": {\"type\": \"integer\"}, \"Message\": {\"type\": \"string\"}, \"State\": {\"type\": \"string\"}}, \"title\": \"ErrorResponse\"}}}", "isNativeDefinition": false}, {"name": "Messages", "definition": "public class Messages\n{\n    /* The errors this Flow raises, one text per language. The languages are the\n       keys of each entry: adding a language is adding its text. */\n    static readonly System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.Dictionary&lt;string, string&gt;&gt; Texts =\n        new System.Collections.Generic.Dictionary&lt;string, System.Collections.Generic.Dictionary&lt;string, string&gt;&gt;\n        {\n            { \"orderId is required\", new System.Collections.Generic.Dictionary&lt;string, string&gt; { { \"en\", \"orderId is required\" }, { \"uk\", \"Потрібно вказати orderId\" }, { \"fr\", \"orderId est obligatoire\" }, { \"pt\", \"orderId é obrigatório\" }, { \"es\", \"orderId es obligatorio\" }, { \"de\", \"orderId ist erforderlich\" }, { \"ar\", \"الحقل orderId مطلوب\" } } }\n        };\n\n    /* The language to answer in: the first language of Accept-Language (by q)\n       that has this text, then the stand's language, then English. */\n    public static string Language(string message, string acceptLanguage, string standLanguage)\n    {\n        // a message without texts (a technical exception) keeps its own words\n        if (message == null || !Texts.TryGetValue(message, out var byLanguage))\n            return null;\n        foreach (var language in Preferred(acceptLanguage))\n            if (byLanguage.ContainsKey(language))\n                return language;\n        if (!string.IsNullOrEmpty(standLanguage) &amp;&amp; byLanguage.ContainsKey(standLanguage))\n            return standLanguage;\n        return \"en\";\n    }\n\n    public static string Text(string message, string language)\n    {\n        if (message != null &amp;&amp; language != null &amp;&amp; Texts.TryGetValue(message, out var byLanguage)\n            &amp;&amp; byLanguage.TryGetValue(language, out var text))\n            return text;\n        return message;\n    }\n\n    /* \"uk-UA,uk;q=0.9,en;q=0.8\" -&gt; uk, en: primary subtags, highest q first. */\n    static System.Collections.Generic.List&lt;string&gt; Preferred(string header)\n    {\n        var weighted = new System.Collections.Generic.List&lt;System.Tuple&lt;string, double&gt;&gt;();\n        foreach (var part in (header ?? \"\").Split(','))\n        {\n            var pieces = part.Split(';');\n            var language = pieces[0].Trim().Split('-')[0].ToLowerInvariant();\n            double q = 1;\n            for (int i = 1; i &lt; pieces.Length; i++)\n            {\n                var p = pieces[i].Trim();\n                if (p.StartsWith(\"q=\"))\n                    double.TryParse(p.Substring(2), System.Globalization.NumberStyles.Float,\n                                    System.Globalization.CultureInfo.InvariantCulture, out q);\n            }\n            if (language.Length &gt; 0 &amp;&amp; language != \"*\" &amp;&amp; q &gt; 0)\n                weighted.Add(System.Tuple.Create(language, q));\n        }\n        weighted.Sort((a, b) =&gt; b.Item2.CompareTo(a.Item2));\n        var result = new System.Collections.Generic.List&lt;string&gt;();\n        foreach (var item in weighted)\n            if (!result.Contains(item.Item1))\n                result.Add(item.Item1);\n        return result;\n    }\n}", "isNativeDefinition": true}]</gp:globalParameter>
    <gp:globalParameter name="ExternalTypes">[{"name": "ExternalConfig", "definition": "types://external/ConfigActivity/Config"}]</gp:globalParameter>
    <gp:globalParameter name="CodeActions">[{"name": "HandleException", "initCode": "ErrorResponse HandleException(PassingResult prevData)\n{\n    Logger.LogError($\"flow failed: {prevData.Exception?.Message}\");\n    WorkflowEnvironment.Variables[\"StatusCode\"] = 500;\n    string acceptLanguage = null;\n    if (WorkflowEnvironment.Variables.TryGetValue(\"HttpRequest\", out object rawRequest)\n        &amp;&amp; rawRequest is Microsoft.AspNetCore.Http.HttpRequest httpRequest)\n        acceptLanguage = httpRequest.Headers[\"Accept-Language\"].ToString();\n    else\n        acceptLanguage = ServiceProvider.GetService&lt;HttpRequestService&gt;()?.Request?.Headers?\n            .FirstOrDefault(h =&gt; string.Equals(h.Key, \"Accept-Language\", StringComparison.OrdinalIgnoreCase)).Value;\n    // the engine wraps the step's exception: the text to translate is the one the step threw\n    var reason = prevData.Exception?.GetBaseException()?.Message;\n    var language = Messages.Language(reason, acceptLanguage, Parameters.config?.language);\n    if (WorkflowEnvironment.Variables.TryGetValue(\"HttpResponse\", out object rawResponse)\n        &amp;&amp; rawResponse is Microsoft.AspNetCore.Http.HttpResponse httpResponse)\n    {\n        httpResponse.StatusCode = 500;\n        if (language != null)\n            httpResponse.Headers[\"Content-Language\"] = language;\n    }\n    return new ErrorResponse()\n    {\n        Message = language != null ? Messages.Text(reason, language) : prevData.Exception?.Message,\n        LevelMessage = \"11\",\n        statusCode = 500,\n        State = \"1\"\n    };\n}", "initParameters": [{"name": "Result", "type": "ErrorResponse"}, {"name": "prevData", "type": "PassingResult", "required": true}]}]</gp:globalParameter>
    <gp:globalParameter name="Functions">[]</gp:globalParameter>
    <gp:globalParameter name="UsedLibs">[{"name": "ConfigActivity", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}]</gp:globalParameter>
    <gp:globalParameter name="Parameters">[{"name": "config", "type": "ExternalConfig", "initialValue": ""}]</gp:globalParameter>
  </extensionElements>
  <process id="Process_error_as_branch" name="error-as-branch">
      <documentation>An error is a branch of the diagram, with its own typed answer.
Source: https://github.com/mef-dev/bpmn-examples/tree/master/flow-patterns/02-error-handling</documentation>
    <dataObjectReference id="DO_Input" name="OrderRequest" dataObjectRef="Do_Input" />
    <dataObject id="Do_Input" />
    <dataObjectReference id="DO_Output" name="OrderRequest" dataObjectRef="Do_Output" />
    <dataObjectReference id="DO_Output_1" name="ErrorResponse" dataObjectRef="Do_Output_1" />
    <dataObject id="Do_Output_1" />
    <dataObject id="Do_Output" />
    <startEvent id="Ev_Start" name="error-as-branch">
      <documentation>Starts error-as-branch. Request: OrderRequest (orderId: string).</documentation>
      <outgoing>Fl_001</outgoing>
      <dataOutputAssociation id="Doa_Input">
        <targetRef>DO_Input</targetRef>
      </dataOutputAssociation>
    </startEvent>
    <callActivity id="CA_Config" name="Get Config">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "bpmn-examples-config", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_001</incoming>
      <outgoing>Fl_002</outgoing>
    </callActivity>
    <task id="T_ParseConfig" name="Parse Config">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// A Call Activity result is converted through JSON: new JSON(...)\n// takes the called Flow's object and JSON alike.\nExternalConfig cfg = new JSON(#Previous).Cast&lt;ExternalConfig&gt;()\n    ?? throw new Exception(\"bpmn-examples-config returned no settings\");\nParameters.config = cfg;\nLogger.LogInformation($\"config loaded from bpmn-examples-config\");\nreturn cfg;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_002</incoming>
      <outgoing>Fl_003</outgoing>
    </task>
    <task id="T_Validate" name="validate the order">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// Let it throw. Catching here would hide the failure from the diagram\n// and the process would carry on down the happy path with no order.\nif (string.IsNullOrEmpty(Input.orderId))\n    throw new Exception(\"orderId is required\");\n\nLogger.LogInformation($\"order {Input.orderId} accepted\");\nreturn new OrderRequest() { orderId = Input.orderId };"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_003</incoming>
      <outgoing>Fl_004</outgoing>
    </task>
    <endEvent id="Ev_End" name="error-as-branch">
      <documentation>Success, HTTP 200, ACCEPTED: returns OrderRequest.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "200", "exampelsVariants": [{"title": "ACCEPTED", "value": "{\n  \"orderId\": \"ORD-1001\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_004</incoming>
      <property id="Prop_Ev_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_End">
        <sourceRef>DO_Output</sourceRef>
        <targetRef>Prop_Ev_End</targetRef>
      </dataInputAssociation>
    </endEvent>
    <task id="T_HandleException" name="handle Exception">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Action", "action": "HandleException", "actionParam": {"prevData": "#PreviousData"}}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_005</incoming>
      <incoming>Fl_006</incoming>
      <outgoing>Fl_007</outgoing>
    </task>
    <endEvent id="Ev_Failed" name="error-as-branch">
      <documentation>Failure, HTTP 500: the order has no orderId. message is in the caller's language (Accept-Language), else in the stand's language, else in English.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "500", "exampelsVariants": [{"title": "REJECTED", "value": "{\n  \"levelMessage\": \"11\",\n  \"statusCode\": 500,\n  \"message\": \"orderId is required\",\n  \"state\": \"1\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_007</incoming>
      <property id="Prop_Ev_Failed" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_Failed">
        <sourceRef>DO_Output_1</sourceRef>
        <targetRef>Prop_Ev_Failed</targetRef>
      </dataInputAssociation>
    </endEvent>
    <boundaryEvent id="Ev_Err_T_ParseConfig" name="" attachedToRef="T_ParseConfig">
      <outgoing>Fl_005</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_ParseConfig" />
    </boundaryEvent>
    <boundaryEvent id="Ev_Err_T_Validate" name="" attachedToRef="T_Validate">
      <outgoing>Fl_006</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_Validate" />
    </boundaryEvent>
    <sequenceFlow id="Fl_001" sourceRef="Ev_Start" targetRef="CA_Config" />
    <sequenceFlow id="Fl_002" sourceRef="CA_Config" targetRef="T_ParseConfig" />
    <sequenceFlow id="Fl_003" sourceRef="T_ParseConfig" targetRef="T_Validate" />
    <sequenceFlow id="Fl_004" sourceRef="T_Validate" targetRef="Ev_End" />
    <sequenceFlow id="Fl_005" sourceRef="Ev_Err_T_ParseConfig" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_006" sourceRef="Ev_Err_T_Validate" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_007" sourceRef="T_HandleException" targetRef="Ev_Failed" />
    <textAnnotation id="An_Input">
      <text>Example input:
{
  "orderId": "ORD-1001"
}</text>
    </textAnnotation>
    <association id="As_An_Input" sourceRef="An_Input" targetRef="Ev_Start" />
    <textAnnotation id="An_T_Validate">
      <text>The step throws instead of catching. Catching here would
hide the failure from the diagram, and the process would
carry on down the happy path with no order.</text>
    </textAnnotation>
    <association id="As_An_T_Validate" sourceRef="An_T_Validate" targetRef="T_Validate" />

  </process>
