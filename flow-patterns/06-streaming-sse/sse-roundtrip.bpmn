    <task id="Activity_Read_Response" name="Read Response">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"List&lt;string&gt; result = new List&lt;string&gt;();\nint counter = 0;\nstring data = #Previous.Reader.ReadLine();\nwhile (data != null)\n{\n\tif (!string.IsNullOrEmpty(data))\n\t{\n\t\tresult.Add(data);\n\t\tif(data.EndsWith($\"\\\"{Parameters.stopWord}\\\"\"))\n            counter ++;\n\t}\n\tif(counter &gt;= Parameters.stopWordsCount)\n\t{\n\t    #Previous.Reader.Dispose();\n\t    return result;\n\t}\n\t\n\tdata = #Previous.Reader.ReadLine();\n}\n#Previous.Reader.Dispose();\nresult.Add(\"null\");\nreturn result;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Flow_0isdzfm</incoming>
      <outgoing>Flow_1</outgoing>
    </task>
    <sequenceFlow id="Flow_1" sourceRef="Activity_Read_Response" targetRef="Gateway_16lzu5i" />
