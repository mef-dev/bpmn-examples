    <task id="Activity_Return_Ok" name="prepare Success response">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"List&lt;string&gt; d = (List&lt;string&gt;)#Previous[\"Activity_Read_Response\"]; \n\nstring answer=\"\";\nstring messageAnswer = \"data: \\\"\"+Input.message+\"\\\"\";\nforeach(var s in d)\n{\nLogger.LogInformation(s);\n if (s == messageAnswer){\nanswer=messageAnswer; \n//break;\n}\n\n\n}\nif (Parameters.content.subscribers == null)\n{\n   return null ; \n}\nreturn new{ answer,\n   Parameters.content.subscribers\n};"}</ep:elementParameter>
      </extensionElements>
