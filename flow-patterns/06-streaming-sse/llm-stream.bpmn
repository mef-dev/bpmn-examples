    <dataObject id="DataObject_080emqn" />
    <task id="Action_Read_Request" name="Read Request">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"Logger.LogInformation($\"{#Previous.IsStreamResponse}\");\nint result = 0;\nstring data = #Previous.Reader.ReadLine();\nwhile ((data != null) &amp;&amp; Parameters.Stop != true)\n{\n\tLogger.LogInformation($\"--&gt;{data}\");\n\tif (!string.IsNullOrEmpty(data))\n\t{\n\t\tvar eventData = data.StartsWith(\"data:\")?data.Substring(5).Trim():data;\n\t\tif (!string.IsNullOrEmpty(eventData))\n\t\t{\n\t\t\tAction.BoundaryEvents[\"Event_Start_Send_Message\"].Raise(eventData);\n\t\t\tresult++;\n\t\t}\n\t}\n\tdata = #Previous.Reader.ReadLine();\n}\n\nreturn new ResponseModel()\n{\n    statuscode = #Previous.StatusCode,\n    success = true,\n    details = $\"{result} peaces readed\"\n};"}</ep:elementParameter>
      </extensionElements>
      <incoming>Flow_1nv7iqf</incoming>
      <outgoing>Flow_0dc2tim</outgoing>
    </task>
    <sequenceFlow id="Flow_0dc2tim" sourceRef="Action_Read_Request" targetRef="Event_0sav6wr" />
    <task id="Activity_Handle_Message" name="Handle Message">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType":"Expression","action":"string rawStr = (string)#Previous;\n            if(rawStr.Contains(\"\\\"finish_reason\\\": \\\"stop\\\"\"))\n                Parameters.Stop = true;\nstring result = rawStr;\nreturn result;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Flow_13i8flm</incoming>
      <outgoing>Flow_0p5t37u</outgoing>
    </task>
