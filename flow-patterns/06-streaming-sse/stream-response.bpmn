      <bpmndi:BPMNShape id="Sh_T_ParseConfig" bpmnElement="T_ParseConfig">
        <omgdc:Bounds x="250" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_Call" bpmnElement="T_Call">
        <omgdc:Bounds x="250" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_Stream" bpmnElement="T_Stream">
        <omgdc:Bounds x="250" y="600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_End" bpmnElement="Ev_End">
        <omgdc:Bounds x="282" y="730" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_HandleException" bpmnElement="T_HandleException">
        <omgdc:Bounds x="570" y="532" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Failed" bpmnElement="Ev_Failed">
        <omgdc:Bounds x="602" y="662" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Err_T_ParseConfig" bpmnElement="Ev_Err_T_ParseConfig">
        <omgdc:Bounds x="332" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Err_T_Call" bpmnElement="Ev_Err_T_Call">
        <omgdc:Bounds x="332" y="532" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_Fl_001" bpmnElement="Fl_001">
        <di:waypoint x="300" y="116" />
        <di:waypoint x="300" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_002" bpmnElement="Fl_002">
        <di:waypoint x="300" y="290" />
        <di:waypoint x="300" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_003" bpmnElement="Fl_003">
        <di:waypoint x="300" y="420" />
        <di:waypoint x="300" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_004" bpmnElement="Fl_004">
        <di:waypoint x="300" y="550" />
        <di:waypoint x="300" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_005" bpmnElement="Fl_005">
        <di:waypoint x="300" y="680" />
