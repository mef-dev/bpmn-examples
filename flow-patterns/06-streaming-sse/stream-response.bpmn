<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gp="http://some-company/schema/bpmn/qa" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ep="http://some-company/schema/bpmn/ep" targetNamespace="" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <extensionElements>
    <gp:globalParameter name="InnerTypes">[{"name": "StreamRequest", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/StreamRequest\", \"definitions\": {\"StreamRequest\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"topic\": {\"type\": \"string\"}}, \"title\": \"StreamRequest\"}}}", "isNativeDefinition": false}, {"name": "ErrorResponse", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/ErrorResponse\", \"definitions\": {\"ErrorResponse\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"LevelMessage\": {\"type\": \"string\"}, \"statusCode\": {\"type\": \"integer\"}, \"Message\": {\"type\": \"string\"}, \"State\": {\"type\": \"string\"}}, \"title\": \"ErrorResponse\"}}}", "isNativeDefinition": false}]</gp:globalParameter>
    <gp:globalParameter name="ExternalTypes">[{"name": "ExternalConfig", "definition": "types://external/ConfigActivity/Config"}]</gp:globalParameter>
    <gp:globalParameter name="CodeActions">[{"name": "HandleException", "initCode": "ErrorResponse HandleException(PassingResult prevData)\n{\n    Logger.LogError($\"flow failed: {prevData.Exception?.Message}\");\n    WorkflowEnvironment.Variables[\"StatusCode\"] = 500;\n    if (WorkflowEnvironment.Variables.TryGetValue(\"HttpResponse\", out object rawResponse)\n        &amp;&amp; rawResponse is Microsoft.AspNetCore.Http.HttpResponse httpResponse)\n        httpResponse.StatusCode = 500;\n    return new ErrorResponse()\n    {\n        Message = prevData.Exception?.Message,\n        LevelMessage = \"11\",\n        statusCode = 500,\n        State = \"1\"\n    };\n}", "initParameters": [{"name": "Result", "type": "ErrorResponse"}, {"name": "prevData", "type": "PassingResult", "required": true}]}]</gp:globalParameter>
    <gp:globalParameter name="Functions">[{"name": "RestApi/GET", "initCode": "functions://default/RestApi/Get", "initParameters": [{"name": "Uri", "type": "Uri", "required": true, "nullable": false}, {"name": "Login", "type": "String", "required": false, "nullable": false}, {"name": "Password", "type": "String", "required": false, "nullable": false}, {"name": "Headers", "type": "StringDictionary", "required": false, "nullable": false}, {"name": "Encoding", "type": "String", "required": false, "nullable": false}, {"name": "Timeout", "type": "int", "required": false, "nullable": false}, {"name": "Result", "type": "HttpResponse", "required": false, "nullable": false}]}]</gp:globalParameter>
    <gp:globalParameter name="UsedLibs">[{"name": "ConfigActivity", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}]</gp:globalParameter>
    <gp:globalParameter name="Parameters">[{"name": "config", "type": "ExternalConfig", "initialValue": ""}]</gp:globalParameter>
  </extensionElements>
  <process id="Process_stream_response" name="stream-response">
      <documentation>Reads a response as it arrives and passes each chunk on.
Source: https://github.com/mef-dev/bpmn-examples/tree/master/flow-patterns/06-streaming-sse</documentation>
    <dataObjectReference id="DO_Input" name="StreamRequest" dataObjectRef="Do_Input" />
    <dataObject id="Do_Input" />
    <dataObjectReference id="DO_Output" name="StreamRequest" dataObjectRef="Do_Output" />
    <dataObjectReference id="DO_Output_1" name="ErrorResponse" dataObjectRef="Do_Output_1" />
    <dataObject id="Do_Output_1" />
    <dataObject id="Do_Output" />
    <startEvent id="Ev_Start" name="stream-response">
      <documentation>Starts stream-response. Request: StreamRequest (topic: string).</documentation>
      <extensionElements>
        <ep:elementParameter name="StartSignalRoute">{"status": "HttpRequestAttributes", "examples": {"CHUNK": {"summary": "the example input", "description": "", "value": "{\n  \"topic\": \"USD\"\n}"}}}</ep:elementParameter>
      </extensionElements>
      <outgoing>Fl_001</outgoing>
      <dataOutputAssociation id="Doa_Input">
        <targetRef>DO_Input</targetRef>
      </dataOutputAssociation>
    </startEvent>
    <callActivity id="CA_Config" name="Get Config">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "bpmn-examples-config", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_001</incoming>
      <outgoing>Fl_002</outgoing>
    </callActivity>
    <task id="T_ParseConfig" name="Parse Config">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// A Call Activity result is converted through JSON: new JSON(...)\n// takes the called Flow's object and JSON alike.\nExternalConfig cfg = new JSON(#Previous).Cast&lt;ExternalConfig&gt;()\n    ?? throw new Exception(\"bpmn-examples-config returned no settings\");\nParameters.config = cfg;\nLogger.LogInformation($\"config loaded from bpmn-examples-config\");\nreturn cfg;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_002</incoming>
      <outgoing>Fl_003</outgoing>
    </task>
    <task id="T_Call" name="open the stream">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Function", "action": "RestApi/GET", "actionParam": {"Uri": "{Parameters.config.listUrl}?_limit=3", "Encoding": "utf-8", "Timeout": 30000, "Headers": "{\"Accept\":\"application/json\"}", "Login": "$\"{Parameters.config.login}\"", "Password": "$\"{Parameters.config.password}\""}}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_003</incoming>
      <outgoing>Fl_004</outgoing>
    </task>
    <task id="T_Stream" name="read the stream line by line">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// A streamed answer comes as Reader; an ordinary one is already in Content.\nvar reader = #Previous.Reader;\nvar rest = new Queue&lt;string&gt;((#Previous.Content ?? \"\").Split('\\n'));\nFunc&lt;string&gt; next = () =&gt; reader != null ? reader.ReadLine()\n                        : rest.Count &gt; 0 ? rest.Dequeue() : null;\nint sent = 0;\nfor (var line = next(); line != null; line = next())\n{\n    if (string.IsNullOrWhiteSpace(line)) continue;   // separators, not chunks\n    Action.BoundaryEvents[\"Event_Chunk\"].Raise(line); // out as it lands\n    sent++;\n}\nreader?.Dispose();\nLogger.LogInformation($\"{sent} chunks passed on for {Input.topic}\");\nreturn new StreamRequest() { topic = Input.topic };"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_004</incoming>
      <outgoing>Fl_005</outgoing>
    </task>
    <endEvent id="Ev_End" name="stream-response">
      <documentation>Success, HTTP 200, CHUNK: returns StreamRequest.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "200", "exampelsVariants": [{"title": "CHUNK", "value": "{\n  \"topic\": \"USD\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_005</incoming>
      <property id="Prop_Ev_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_End">
        <sourceRef>DO_Output</sourceRef>
        <targetRef>Prop_Ev_End</targetRef>
      </dataInputAssociation>
    </endEvent>
    <task id="T_HandleException" name="handle Exception">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Action", "action": "HandleException", "actionParam": {"prevData": "#PreviousData"}}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_006</incoming>
      <incoming>Fl_007</incoming>
      <incoming>Fl_008</incoming>
      <outgoing>Fl_009</outgoing>
    </task>
    <endEvent id="Ev_Failed" name="stream-response">
      <documentation>Failure, HTTP 500, STREAM_FAILED: returns ErrorResponse built by the error branch from the exception of the step that failed.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "500", "exampelsVariants": [{"title": "STREAM_FAILED", "value": "{\n  \"levelMessage\": \"11\",\n  \"statusCode\": 500,\n  \"message\": \"Error while try to call action 'T_Call/open the stream'\",\n  \"state\": \"1\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_009</incoming>
      <property id="Prop_Ev_Failed" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_Failed">
        <sourceRef>DO_Output_1</sourceRef>
        <targetRef>Prop_Ev_Failed</targetRef>
      </dataInputAssociation>
    </endEvent>
    <boundaryEvent id="Ev_Err_CA_Config" name="" attachedToRef="CA_Config">
      <outgoing>Fl_006</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_CA_Config" />
    </boundaryEvent>
    <boundaryEvent id="Ev_Err_T_ParseConfig" name="" attachedToRef="T_ParseConfig">
      <outgoing>Fl_007</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_ParseConfig" />
    </boundaryEvent>
    <boundaryEvent id="Ev_Err_T_Call" name="" attachedToRef="T_Call">
      <outgoing>Fl_008</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_Call" />
    </boundaryEvent>
    <sequenceFlow id="Fl_001" sourceRef="Ev_Start" targetRef="CA_Config" />
    <sequenceFlow id="Fl_002" sourceRef="CA_Config" targetRef="T_ParseConfig" />
    <sequenceFlow id="Fl_003" sourceRef="T_ParseConfig" targetRef="T_Call" />
    <sequenceFlow id="Fl_004" sourceRef="T_Call" targetRef="T_Stream" />
    <sequenceFlow id="Fl_005" sourceRef="T_Stream" targetRef="Ev_End" />
    <sequenceFlow id="Fl_006" sourceRef="Ev_Err_CA_Config" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_007" sourceRef="Ev_Err_T_ParseConfig" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_008" sourceRef="Ev_Err_T_Call" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_009" sourceRef="T_HandleException" targetRef="Ev_Failed" />
    <boundaryEvent id="Event_Chunk" name="chunk" cancelActivity="false" attachedToRef="T_Stream">
      <outgoing>Fl_Event_Chunk</outgoing>
      <messageEventDefinition id="Med_Event_Chunk" />
    </boundaryEvent>
    <intermediateThrowEvent id="Event_Send" name="send the chunk on">
      <extensionElements>
        <ep:elementParameter name="ThrowMessageEvent">{"tsk_ProcessName": "Server-side events", "data": {"alias": "examples", "pluginname": "flow-patterns"}, "lang": "en"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_Event_Chunk</incoming>
      <messageEventDefinition id="Med_Event_Send" />
    </intermediateThrowEvent>
    <sequenceFlow id="Fl_Event_Chunk" sourceRef="Event_Chunk" targetRef="Event_Send" />
    <textAnnotation id="An_Input">
      <text>Example input:
{
  "topic": "USD"
}</text>
    </textAnnotation>
    <association id="As_An_Input" sourceRef="An_Input" targetRef="Ev_Start" />
    <textAnnotation id="An_T_Call">
      <text>The endpoint and its credentials come from the
configuration Flow, so this model carries no address of
its own.</text>
    </textAnnotation>
    <association id="As_An_T_Call" sourceRef="An_T_Call" targetRef="T_Call" />
    <textAnnotation id="An_T_Stream">
      <text>Reader exists only for a response the platform marked as a
stream, and then only one line is held at a time however
long the answer is. For an ordinary answer Reader is null
and the body is already in Content, so the step covers
both: which one arrives is decided by the endpoint, not by
this Flow.</text>
    </textAnnotation>
    <association id="As_An_T_Stream" sourceRef="An_T_Stream" targetRef="T_Stream" />

  </process>
  <bpmndi:BPMNDiagram id="Di_Process_stream_response">
    <bpmndi:BPMNPlane id="Dp_Process_stream_response" bpmnElement="Process_stream_response">
