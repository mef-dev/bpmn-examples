      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Sh_DO_Output_1" bpmnElement="DO_Output_1">
        <omgdc:Bounds x="412" y="122" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="386" y="178" width="88" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_An_Input" bpmnElement="An_Input">
        <omgdc:Bounds x="238" y="-34" width="123" height="74" />
      </bpmndi:BPMNShape>
