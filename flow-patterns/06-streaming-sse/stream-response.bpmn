        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="66" y="246" width="88" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Start" bpmnElement="Ev_Start">
