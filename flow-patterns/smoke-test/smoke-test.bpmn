      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nParameters.report.Expect(\"CA_ErrorFail\", \"02 error-as-branch, empty order\", \"a thrown exception ends on the error branch, not in the caller\",\n    #Previous, \"orderId is required\", true);\nreturn null;"}</ep:elementParameter>
