        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nParameters.report.Expect(\"CA_Prompt\", \"08 structured-prompt\", \"a prompt built as typed chat messages\",\n    #Previous, \"\\\"role\\\":\\\"system\\\"\", false);\nreturn null;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_033</incoming>
      <incoming>Fl_060</incoming>
      <outgoing>Fl_034</outgoing>
    </task>
    <task id="T_In_Archive" name="09 input">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "return \"{\\\"note\\\":\\\"quarterly summary\\\"}\";"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_034</incoming>
      <outgoing>Fl_035</outgoing>
    </task>
    <callActivity id="CA_Archive" name="09 archive-and-link">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "archive-and-link", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/archive-and-link/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_035</incoming>
      <outgoing>Fl_036</outgoing>
    </callActivity>
    <task id="T_Check_Archive" name="09 check">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nParameters.report.Expect(\"CA_Archive\", \"09 archive-and-link\", \"a file in a store, an archive and a link to it\",\n    #Previous, \"\\\"url\\\"\", false);\nreturn null;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_036</incoming>
      <incoming>Fl_062</incoming>
      <outgoing>Fl_037</outgoing>
    </task>
    <task id="T_Verdict" name="verdict">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "var report = SmokeReport.Ensure(Parameters.report).Finish();\nLogger.LogInformation($\"smoke test: {report.total - report.failed}/{report.total} passed\");\nWorkflowEnvironment.Variables[\"StatusCode\"] = report.passed ? 200 : 500;\nreturn report;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_037</incoming>
      <outgoing>Fl_038</outgoing>
    </task>
    <endEvent id="Ev_End" name="smoke-test">
      <documentation>Every check passed: HTTP 200 and the report.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "200", "exampelsVariants": [{"title": "ALL_PASSED", "value": "{\n  \"platform\": \"UCP.API 2.0.2.221\",\n  \"engine\": \"Natec.Workflow.Runtime 1.0.0.0\",\n  \"total\": 11,\n  \"failed\": 0,\n  \"passed\": true,\n  \"checks\": [\n    {\n      \"step\": \"CA_FirstFlow\",\n      \"check\": \"01 first-flow\",\n      \"capability\": \"Input is the caller's payload, the previous step's result is passed on\",\n      \"passed\": true,\n      \"detail\": \"{\\\"name\\\":\\\"Ada\\\",\\\"language\\\":\\\"en\\\"}\"\n    }\n  ]\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_038</incoming>
      <property id="Prop_Ev_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_End">
        <sourceRef>DO_Output</sourceRef>
        <targetRef>Prop_Ev_End</targetRef>
      </dataInputAssociation>
    </endEvent>
