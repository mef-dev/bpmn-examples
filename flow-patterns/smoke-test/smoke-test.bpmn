      <outgoing>Fl_008</outgoing>
    </task>
    <callActivity id="CA_ErrorOk" name="02a error-as-branch">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "error-as-branch", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/error-as-branch/#latest</ep:elementParameter>
