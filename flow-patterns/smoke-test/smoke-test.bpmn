    <task id="T_Check_ErrorOk" name="02a check">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nParameters.report.Expect(\"CA_ErrorOk\", \"02 error-as-branch, valid order\", \"a valid request passes the step that may throw\",\n    #Previous, \"\\\"orderId\\\":\\\"ORD-1001\\\"\", false);\nreturn null;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_009</incoming>
      <incoming>Fl_044</incoming>
      <outgoing>Fl_010</outgoing>
    </task>
