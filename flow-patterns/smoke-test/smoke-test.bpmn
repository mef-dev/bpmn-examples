<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gp="http://some-company/schema/bpmn/qa" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ep="http://some-company/schema/bpmn/ep" targetNamespace="" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <extensionElements>
    <gp:globalParameter name="InnerTypes">[{"name": "SmokeReport", "isNativeDefinition": true, "definition": "public class SmokeReport\n{\n    /* The caller's label for this run, as given in the request. */\n    public string run { get; set; }\n    /* The host and engine versions of the process that ran the test. */\n    public string platform { get; set; }\n    public string engine { get; set; }\n    public string startedUtc { get; set; }\n    public string finishedUtc { get; set; }\n    public int total { get; set; }\n    public int failed { get; set; }\n    public bool passed { get; set; }\n    public System.Collections.Generic.List&lt;SmokeCheck&gt; checks { get; set; } = new System.Collections.Generic.List&lt;SmokeCheck&gt;();\n\n    public static SmokeReport Ensure(SmokeReport report)\n    {\n        return report ?? new SmokeReport() { startedUtc = System.DateTime.UtcNow.ToString(\"o\") };\n    }\n\n    /* A step threw: its boundary event led here. */\n    public void Error(string step, string check, System.Exception error)\n    {\n        checks.Add(new SmokeCheck() { step = step, check = check, capability = \"the step runs\", passed = false,\n            detail = error == null ? \"failed without an exception\" : error.GetType().Name + \": \" + error.Message });\n    }\n\n    /* The called Flow answered: check the answer. A step that already threw is not checked twice. */\n    public void Expect(string step, string check, string capability, object result, string marker, bool failureExpected)\n    {\n        if (checks.Exists(c =&gt; c.step == step))\n            return;\n        string text = null;\n        if (result != null)\n            text = result is string s ? s\n                 : result.GetType().Name == \"JSON\" ? result.ToString()\n                 : Newtonsoft.Json.JsonConvert.SerializeObject(result);\n        string failure = null;\n        if (text != null &amp;&amp; text.TrimStart().StartsWith(\"{\"))\n        {\n            var answer = Newtonsoft.Json.Linq.JObject.Parse(text);\n            var code = answer[\"statusCode\"];\n            if (answer[\"levelMessage\"] != null &amp;&amp; code != null &amp;&amp; ((int)code &lt; 200 || (int)code &gt; 299))\n                failure = (string)answer[\"message\"] ?? \"no message\";\n        }\n        bool passed;\n        string detail;\n        if (failureExpected)\n        {\n            /* the failure branch must answer for the reason the check names, not for any reason */\n            passed = failure != null &amp;&amp; failure.IndexOf(marker, System.StringComparison.OrdinalIgnoreCase) &gt;= 0;\n            detail = passed ? \"the failure branch answered: \" + failure\n                   : failure != null ? \"the failure branch answered, but not with '\" + marker + \"': \" + failure\n                   : \"expected the failure branch, got: \" + Cut(text);\n        }\n        else if (text == null)\n        {\n            passed = false;\n            detail = \"no answer: the called Flow ended without a result, usually an unhandled error inside it (see its trace)\";\n        }\n        else if (failure != null)\n        {\n            passed = false;\n            detail = \"the failure branch answered: \" + failure;\n        }\n        else\n        {\n            passed = text.IndexOf(marker, System.StringComparison.OrdinalIgnoreCase) &gt;= 0;\n            detail = passed ? Cut(text) : \"no '\" + marker + \"' in: \" + Cut(text);\n        }\n        checks.Add(new SmokeCheck() { step = step, check = check, capability = capability, passed = passed, detail = detail });\n    }\n\n    public SmokeReport Finish()\n    {\n        total = checks.Count;\n        failed = checks.FindAll(c =&gt; !c.passed).Count;\n        passed = total &gt; 0 &amp;&amp; failed == 0;\n        finishedUtc = System.DateTime.UtcNow.ToString(\"o\");\n        return this;\n    }\n\n    private static string Cut(string text)\n    {\n        if (text == null) return \"null\";\n        return text.Length &lt;= 300 ? text : text.Substring(0, 300) + \"...\";\n    }\n}", "dataObjectRefName": "SmokeReport"}, {"name": "SmokeCheck", "isNativeDefinition": true, "definition": "public class SmokeCheck\n{\n    /* One line of the report: which step, what it proves, and what came back. */\n    public string step { get; set; }\n    public string check { get; set; }\n    public string capability { get; set; }\n    public bool passed { get; set; }\n    public string detail { get; set; }\n}", "dataObjectRefName": "SmokeCheck"}, {"name": "SmokeRequest", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/SmokeRequest\", \"definitions\": {\"SmokeRequest\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"run\": {\"type\": \"string\"}}, \"title\": \"SmokeRequest\"}}}", "isNativeDefinition": false}, {"name": "ErrorResponse", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/ErrorResponse\", \"definitions\": {\"ErrorResponse\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"LevelMessage\": {\"type\": \"string\"}, \"statusCode\": {\"type\": \"integer\"}, \"Message\": {\"type\": \"string\"}, \"State\": {\"type\": \"string\"}}, \"title\": \"ErrorResponse\"}}}", "isNativeDefinition": false}]</gp:globalParameter>
    <gp:globalParameter name="ExternalTypes">[{"name": "ExternalConfig", "definition": "types://external/ConfigActivity/Config"}]</gp:globalParameter>
    <gp:globalParameter name="CodeActions">[]</gp:globalParameter>
    <gp:globalParameter name="Functions">[]</gp:globalParameter>
    <gp:globalParameter name="UsedLibs">[{"name": "ConfigActivity", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}, {"name": "Call_first_flow", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/first-flow/#latest", "version": "", "entities": []}, {"name": "Call_error_as_branch", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/error-as-branch/#latest", "version": "", "entities": []}, {"name": "Call_bpmn_examples_config", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}, {"name": "Call_use_config", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/use-config/#latest", "version": "", "entities": []}, {"name": "Call_paged_fetch", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/paged-fetch/#latest", "version": "", "entities": []}, {"name": "Call_raise_event", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/raise-event/#latest", "version": "", "entities": []}, {"name": "Call_stream_response", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/stream-response/#latest", "version": "", "entities": []}, {"name": "Call_http_start", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/http-start/#latest", "version": "", "entities": []}, {"name": "Call_structured_prompt", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/structured-prompt/#latest", "version": "", "entities": []}, {"name": "Call_archive_and_link", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/archive-and-link/#latest", "version": "", "entities": []}]</gp:globalParameter>
    <gp:globalParameter name="Parameters">[{"name": "config", "type": "ExternalConfig", "initialValue": ""}, {"name": "report", "type": "SmokeReport", "initialValue": ""}]</gp:globalParameter>
  </extensionElements>
  <process id="Process_smoke_test" name="smoke-test">
      <documentation>Calls every flow-patterns example and reports, for the platform version that ran it, which capabilities work.
Source: https://github.com/mef-dev/bpmn-examples/tree/master/flow-patterns/smoke-test</documentation>
    <dataObjectReference id="DO_Input" name="SmokeRequest" dataObjectRef="Do_Input" />
    <dataObject id="Do_Input" />
    <dataObjectReference id="DO_Output" name="SmokeReport" dataObjectRef="Do_Output" />
    <dataObject id="Do_Output" />
    <startEvent id="Ev_Start" name="smoke-test">
      <documentation>run: a free label for this run, repeated in the report. Every check runs whatever it says.</documentation>
      <outgoing>Fl_001</outgoing>
      <dataOutputAssociation id="Doa_Input">
        <targetRef>DO_Input</targetRef>
      </dataOutputAssociation>
    </startEvent>
    <callActivity id="CA_Config" name="Get Config">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "bpmn-examples-config", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_001</incoming>
      <outgoing>Fl_002</outgoing>
    </callActivity>
    <task id="T_ParseConfig" name="Parse Config">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// Depending on the platform version a Call Activity returns the\n// called Flow's own object or JSON. Both are accepted.\nvar prev = #Previous;\nExternalConfig cfg = prev as ExternalConfig\n    ?? (prev is JSON json ? json.Cast&lt;ExternalConfig&gt;()\n        : Newtonsoft.Json.JsonConvert.DeserializeObject&lt;ExternalConfig&gt;(\n              Newtonsoft.Json.JsonConvert.SerializeObject(prev)))\n    ?? throw new Exception(\"bpmn-examples-config returned no settings\");\nParameters.config = cfg;\nLogger.LogInformation($\"config loaded from bpmn-examples-config\");\nreturn cfg;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_002</incoming>
      <outgoing>Fl_003</outgoing>
    </task>
    <task id="T_Platform" name="read the platform version">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nvar host = System.Reflection.Assembly.GetEntryAssembly();\nvar file = host == null ? null : System.Reflection.CustomAttributeExtensions\n    .GetCustomAttribute&lt;System.Reflection.AssemblyFileVersionAttribute&gt;(host);\nvar engine = typeof(WorkflowException).Assembly.GetName();\nParameters.report.run = Input.run;\nParameters.report.platform = $\"{host?.GetName().Name} {file?.Version}\";\nParameters.report.engine = $\"{engine.Name} {engine.Version}\";\nLogger.LogInformation($\"smoke test on {Parameters.report.platform}, {Parameters.report.engine}\");\nreturn null;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_003</incoming>
      <incoming>Fl_040</incoming>
      <outgoing>Fl_004</outgoing>
    </task>
    <task id="T_In_FirstFlow" name="01 input">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "return \"{\\\"name\\\":\\\"Ada\\\",\\\"language\\\":\\\"en\\\"}\";"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_004</incoming>
      <outgoing>Fl_005</outgoing>
    </task>
    <callActivity id="CA_FirstFlow" name="01 first-flow">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "first-flow", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/first-flow/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_005</incoming>
      <outgoing>Fl_006</outgoing>
    </callActivity>
    <task id="T_Check_FirstFlow" name="01 check">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "Parameters.report = SmokeReport.Ensure(Parameters.report);\nParameters.report.Expect(\"CA_FirstFlow\", \"01 first-flow\", \"Input is the caller's payload, the previous step's result is passed on\",\n    #Previous, \"\\\"name\\\":\\\"Ada\\\"\", false);\nreturn null;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_006</incoming>
      <incoming>Fl_042</incoming>
      <outgoing>Fl_007</outgoing>
    </task>
    <task id="T_In_ErrorOk" name="02a input">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "return \"{\\\"orderId\\\":\\\"ORD-1001\\\"}\";"}</ep:elementParameter>
      </extensionElements>
