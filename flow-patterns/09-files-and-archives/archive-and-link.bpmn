        <omgdc:Bounds x="332" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Err_T_Write" bpmnElement="Ev_Err_T_Write">
        <omgdc:Bounds x="332" y="662" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_Fl_001" bpmnElement="Fl_001">
        <di:waypoint x="300" y="116" />
