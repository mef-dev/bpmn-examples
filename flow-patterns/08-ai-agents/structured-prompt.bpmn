<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gp="http://some-company/schema/bpmn/qa" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ep="http://some-company/schema/bpmn/ep" targetNamespace="" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <extensionElements>
    <gp:globalParameter name="InnerTypes">[{"name": "PromptRequest", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/PromptRequest\", \"definitions\": {\"PromptRequest\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"question\": {\"type\": \"string\"}, \"tone\": {\"type\": \"string\"}}, \"title\": \"PromptRequest\"}}}", "isNativeDefinition": false}, {"name": "ErrorResponse", "definition": "{\"$schema\": \"http://json-schema.org/draft-06/schema#\", \"$ref\": \"#/definitions/ErrorResponse\", \"definitions\": {\"ErrorResponse\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"LevelMessage\": {\"type\": \"string\"}, \"statusCode\": {\"type\": \"integer\"}, \"Message\": {\"type\": \"string\"}, \"State\": {\"type\": \"string\"}}, \"title\": \"ErrorResponse\"}}}", "isNativeDefinition": false}]</gp:globalParameter>
    <gp:globalParameter name="ExternalTypes">[{"name": "ExternalConfig", "definition": "types://external/ConfigActivity/Config"}, {"name": "ChatMessage", "definition": "types://external/ai/UCP.Common.AI.ChatCompletionsRequestMessageViewModel"}]</gp:globalParameter>
    <gp:globalParameter name="CodeActions">[{"name": "HandleException", "initCode": "ErrorResponse HandleException(PassingResult prevData)\n{\n    Logger.LogError($\"flow failed: {prevData.Exception?.Message}\");\n    WorkflowEnvironment.Variables[\"StatusCode\"] = 500;\n    if (WorkflowEnvironment.Variables.TryGetValue(\"HttpResponse\", out object rawResponse)\n        &amp;&amp; rawResponse is Microsoft.AspNetCore.Http.HttpResponse httpResponse)\n        httpResponse.StatusCode = 500;\n    return new ErrorResponse()\n    {\n        Message = prevData.Exception?.Message,\n        LevelMessage = \"11\",\n        statusCode = 500,\n        State = \"1\"\n    };\n}", "initParameters": [{"name": "Result", "type": "ErrorResponse"}, {"name": "prevData", "type": "PassingResult", "required": true}]}]</gp:globalParameter>
    <gp:globalParameter name="Functions">[]</gp:globalParameter>
    <gp:globalParameter name="UsedLibs">[{"name": "ConfigActivity", "link": "activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest", "version": "", "entities": []}, {"name": "ai", "link": "libs://common/ai", "version": "", "entities": []}]</gp:globalParameter>
    <gp:globalParameter name="Parameters">[{"name": "config", "type": "ExternalConfig", "initialValue": ""}]</gp:globalParameter>
  </extensionElements>
  <process id="Process_structured_prompt" name="structured-prompt">
      <documentation>Builds the model request as typed data instead of a glued string.
Source: https://github.com/mef-dev/bpmn-examples/tree/master/flow-patterns/08-ai-agents</documentation>
    <dataObjectReference id="DO_Input" name="PromptRequest" dataObjectRef="Do_Input" />
    <dataObject id="Do_Input" />
    <dataObjectReference id="DO_Output" name="ChatMessage" dataObjectRef="Do_Output" />
    <dataObjectReference id="DO_Output_1" name="ErrorResponse" dataObjectRef="Do_Output_1" />
    <dataObject id="Do_Output_1" />
    <dataObject id="Do_Output" />
    <startEvent id="Ev_Start" name="structured-prompt">
      <documentation>Starts structured-prompt. Request: PromptRequest (question: string, tone: string).</documentation>
      <outgoing>Fl_001</outgoing>
      <dataOutputAssociation id="Doa_Input">
        <targetRef>DO_Input</targetRef>
      </dataOutputAssociation>
    </startEvent>
    <callActivity id="CA_Config" name="Get Config">
      <extensionElements>
        <ep:elementParameter name="ElementExternalLibDef">{"libName": "bpmn_examples", "libType": "tenant", "flowName": "bpmn-examples-config", "version": "#latest", "packSize": 0}</ep:elementParameter>
        <ep:elementParameter name="ExternalDefinitionLink">activities://bpmn-mnemo/tenant/bpmn_examples/bpmn-examples-config/#latest</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_001</incoming>
      <outgoing>Fl_002</outgoing>
    </callActivity>
    <task id="T_ParseConfig" name="Parse Config">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// A Call Activity result is converted through JSON: new JSON(...)\n// takes the called Flow's object and JSON alike.\nExternalConfig cfg = new JSON(#Previous).Cast&lt;ExternalConfig&gt;()\n    ?? throw new Exception(\"bpmn-examples-config returned no settings\");\nParameters.config = cfg;\nLogger.LogInformation($\"config loaded from bpmn-examples-config\");\nreturn cfg;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_002</incoming>
      <outgoing>Fl_003</outgoing>
    </task>
    <task id="T_Compose" name="compose the prompt">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Expression", "action": "// ChatMessage is the platform's own message type, declared as an\n// external type instead of being copied into this file. One\n// declaration, one shape, no drift between Flows.\nvar messages = new List&lt;ChatMessage&gt;\n{\n    // The system message sets the behaviour, the user message asks.\n    // Keeping them as data — not as one glued string — is what makes\n    // a prompt reviewable and testable.\n    new ChatMessage() { Role = \"system\", Content = $\"Answer in a {Input.tone} tone.\" },\n    new ChatMessage() { Role = \"user\", Content = Input.question }\n};\n\nLogger.LogInformation($\"prompt built from {messages.Count} messages\");\nreturn messages;"}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_003</incoming>
      <outgoing>Fl_004</outgoing>
    </task>
    <endEvent id="Ev_End" name="structured-prompt">
      <documentation>Success, HTTP 200, PROMPT: returns ChatMessage.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "200", "exampelsVariants": [{"title": "PROMPT", "value": "[\n  {\n    \"role\": \"system\",\n    \"content\": \"Answer in a plain tone.\"\n  },\n  {\n    \"role\": \"user\",\n    \"content\": \"What is BPMN?\"\n  }\n]"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_004</incoming>
      <property id="Prop_Ev_End" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_End">
        <sourceRef>DO_Output</sourceRef>
        <targetRef>Prop_Ev_End</targetRef>
      </dataInputAssociation>
    </endEvent>
    <task id="T_HandleException" name="handle Exception">
      <extensionElements>
        <ep:elementParameter name="ElementImplementation">{"actionType": "Action", "action": "HandleException", "actionParam": {"prevData": "#PreviousData"}}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_005</incoming>
      <incoming>Fl_006</incoming>
      <outgoing>Fl_007</outgoing>
    </task>
    <endEvent id="Ev_Failed" name="structured-prompt">
      <documentation>Failure, HTTP 500, PROMPT_FAILED: returns ErrorResponse built by the error branch from the exception of the step that failed.</documentation>
      <extensionElements>
        <ep:elementParameter name="EndSignalRoute">{"status": "HttpRequestAttributes", "code": "500", "exampelsVariants": [{"title": "PROMPT_FAILED", "value": "{\n  \"levelMessage\": \"11\",\n  \"statusCode\": 500,\n  \"message\": \"the prompt could not be built\",\n  \"state\": \"1\"\n}"}]}</ep:elementParameter>
      </extensionElements>
      <incoming>Fl_007</incoming>
      <property id="Prop_Ev_Failed" name="__targetRef_placeholder" />
      <dataInputAssociation id="Dia_Ev_Failed">
        <sourceRef>DO_Output_1</sourceRef>
        <targetRef>Prop_Ev_Failed</targetRef>
      </dataInputAssociation>
    </endEvent>
    <boundaryEvent id="Ev_Err_CA_Config" name="" attachedToRef="CA_Config">
      <outgoing>Fl_005</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_CA_Config" />
    </boundaryEvent>
    <boundaryEvent id="Ev_Err_T_ParseConfig" name="" attachedToRef="T_ParseConfig">
      <outgoing>Fl_006</outgoing>
      <errorEventDefinition id="Eed_Ev_Err_T_ParseConfig" />
    </boundaryEvent>
    <sequenceFlow id="Fl_001" sourceRef="Ev_Start" targetRef="CA_Config" />
    <sequenceFlow id="Fl_002" sourceRef="CA_Config" targetRef="T_ParseConfig" />
    <sequenceFlow id="Fl_003" sourceRef="T_ParseConfig" targetRef="T_Compose" />
    <sequenceFlow id="Fl_004" sourceRef="T_Compose" targetRef="Ev_End" />
    <sequenceFlow id="Fl_005" sourceRef="Ev_Err_CA_Config" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_006" sourceRef="Ev_Err_T_ParseConfig" targetRef="T_HandleException" />
    <sequenceFlow id="Fl_007" sourceRef="T_HandleException" targetRef="Ev_Failed" />
    <textAnnotation id="An_Input">
      <text>Example input:
{
  "question": "What changed in the last release?",
  "tone": "plain"
}</text>
    </textAnnotation>
    <association id="As_An_Input" sourceRef="An_Input" targetRef="Ev_Start" />
    <textAnnotation id="An_T_Compose">
      <text>ChatMessage is the platform's own message type, declared
once as an external type instead of copied into this file.
One declaration, one shape, everywhere.</text>
    </textAnnotation>
    <association id="As_An_T_Compose" sourceRef="An_T_Compose" targetRef="T_Compose" />

  </process>
  <bpmndi:BPMNDiagram id="Di_Process_structured_prompt">
    <bpmndi:BPMNPlane id="Dp_Process_structured_prompt" bpmnElement="Process_structured_prompt">
      <bpmndi:BPMNShape id="Sh_DO_Input" bpmnElement="DO_Input">
        <omgdc:Bounds x="206" y="73" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="180" y="129" width="88" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_DO_Output" bpmnElement="DO_Output">
        <omgdc:Bounds x="358" y="593" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="338" y="649" width="76" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Start" bpmnElement="Ev_Start">
        <omgdc:Bounds x="282" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="326" y="91" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_CA_Config" bpmnElement="CA_Config">
        <omgdc:Bounds x="250" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_ParseConfig" bpmnElement="T_ParseConfig">
        <omgdc:Bounds x="250" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_Compose" bpmnElement="T_Compose">
        <omgdc:Bounds x="250" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_End" bpmnElement="Ev_End">
        <omgdc:Bounds x="282" y="600" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="169" y="611" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T_HandleException" bpmnElement="T_HandleException">
        <omgdc:Bounds x="418" y="315" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Failed" bpmnElement="Ev_Failed">
        <omgdc:Bounds x="568" y="337" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="534" y="317" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Err_CA_Config" bpmnElement="Ev_Err_CA_Config">
        <omgdc:Bounds x="332" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Ev_Err_T_ParseConfig" bpmnElement="Ev_Err_T_ParseConfig">
        <omgdc:Bounds x="332" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_Fl_001" bpmnElement="Fl_001">
        <di:waypoint x="300" y="116" />
        <di:waypoint x="300" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_002" bpmnElement="Fl_002">
        <di:waypoint x="300" y="290" />
        <di:waypoint x="300" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_003" bpmnElement="Fl_003">
        <di:waypoint x="300" y="420" />
        <di:waypoint x="300" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_004" bpmnElement="Fl_004">
        <di:waypoint x="300" y="550" />
        <di:waypoint x="300" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_005" bpmnElement="Fl_005">
        <di:waypoint x="368" y="290" />
        <di:waypoint x="468" y="290" />
        <di:waypoint x="468" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_Fl_006" bpmnElement="Fl_006">
        <di:waypoint x="368" y="420" />
        <di:waypoint x="468" y="420" />
