      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Sh_An_T_Compose" bpmnElement="An_T_Compose">
        <omgdc:Bounds x="-177" y="480" width="387" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_As_An_T_Compose" bpmnElement="As_An_T_Compose">
